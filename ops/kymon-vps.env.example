# TG-CB-7.0 · environment for the `kymon` service (/etc/kymon-vps/env on the VPS).
# Copy values in; never commit real keys.

# Public origin served by Caddy / tunnel
QIMEN_TUNNEL_HOSTNAME=ai-origin.kymon.pp.ua
# Skip the pairing code (frontend sends "open-access"); Host/Origin checks still apply
QIMEN_OPEN_ACCESS=1

# Single direct AI route through ChatGPT2API (provider id "prism")
QIMEN_DIRECT_MODEL=gpt-6-thinking
QIMEN_REASONING_EFFORT=xhigh          # main writer
QIMEN_AUX_REASONING_EFFORT=high       # fidelity review, sentence repair, planner (decision 4)
QIMEN_MAX_REPAIRS=1                   # sentence-level repair rounds before verified fallback
# QIMEN_DELIBERATION=1                # optional advisory planner (one extra model turn)

PRISM_PROXY_BASE_URL=http://127.0.0.1:8787/v1
PRISM_PROXY_API_KEY=__set_on_vps__
# Optional overrides for the legacy structured Prism helpers
# PRISM_MODEL=gpt-6-thinking
# PRISM_REASONING_EFFORT=xhigh
